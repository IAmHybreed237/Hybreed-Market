{
  "name": "Hybreed Market",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000, 7000, 7001, 9000],
  "portsAttributes": {
    "3000": { "label": "Storefront", "onAutoForward": "notify" },
    "7000": { "label": "Admin Dashboard", "onAutoForward": "notify" },
    "7001": { "label": "Vendor Portal", "onAutoForward": "notify" },
    "9000": { "label": "API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
